aws-acc() {
  local ou="$1"
  local env="$2"
  local secret_ref="op://Employee/aws-accounts/$ou-$env"

  local account_id="$(op read "$secret_ref")"

  open "https://ottonova.awsapps.com/start/#/console?account_id=$account_id&role_name=AdministratorAccess"
}

set-tg-env() {
  local input="$1"
  local env="$2"
  local account=""

  if [[ -n "$env" ]]; then
    account="$input"
  else
    env="$input"
  fi

  if [[ -z "$env" ]]; then
    echo "Usage: set-tg-env [account] <env>"
    return 1
  fi

  if [[ -z "$account" ]]; then
    local git_url
    git_url=$(git remote get-url origin 2>/dev/null)
    if [[ $? -ne 0 || -z "$git_url" ]]; then
      echo "Error: Failed to get git remote URL or no git repo found."
      return 1
    fi

    echo "Detected Git remote: $git_url"

    if [[ "$ZSH_VERSION" ]]; then
      setopt rematchpcre 2>/dev/null
      if [[ "$git_url" =~ 'infrastructure/([^/.]+)(\.git)?$' ]]; then
        account="${match[1]}"
      else
        echo "Error: Could not extract account name (Zsh)."
        return 1
      fi
    else
      if [[ "$git_url" =~ infrastructure/([^/.]+)(\.git)?$ ]]; then
        account="${BASH_REMATCH[1]}"
      else
        echo "Error: Could not extract account name (Bash)."
        return 1
      fi
    fi
  fi

  echo "Using aws account: $account-$env"
  echo "Using environment: $env"

  export TF_VAR_environment="$env"
  export AWS_PROFILE="$account-$env"
}

clone() {
  git_url="$1"

  full_repo="${git_url#*:}"
  full_repo="${full_repo%.git}"
  project_name="${full_repo##*/}"

  echo "$full_repo"

  read "yn?Cloning $git_url into $project_name. Continue? [y/N] "
  case $yn in
  [Yy]*)
    git clone "$git_url" "$project_name"
    cd "$project_name" || return 1
    git remote add glab "https://gitlab.on.ag/$full_repo.git"
    ;;
  [Nn]*) return 1 ;;
  *) echo "Please answer yes or no." ;;
  esac
}
