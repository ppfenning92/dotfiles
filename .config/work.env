alias on-preview=". <(op --account=ottonova inject -i "$HOME/.config/secrets.env"); docker run --rm -it -e \"GITLAB_API_TOKEN=\$GITLAB_API_TOKEN\" registry.on.ag/ottonova/software/on-cli preview"

function _tf() {
  op run -- terraform "$@"
}
complete -C /opt/homebrew/bin/terraform terraform
alias tf="_tf"
compdef _terraform _tf

function tg() {
  op run -- terragrunt "$@"
}
complete -C /opt/homebrew/bin/terragrunt terragrunt

function vault() {
  op run -- vault "$@"
}
complete -C /opt/homebrew/bin/vault vault

docker-login-on() {
  op read "op://Employee/gitlab.on.ag/token" | docker login registry.on.ag -u patrick.pfenning --password-stdin
  op read "op://Employee/gitlab.on.ag/token" | skopeo login registry.on.ag -u patrick.pfenning --password-stdin
}

complete -C '/usr/local/bin/aws_completer' aws

# add-glab-remote ()
# {
#   remote=$(git remote get-url origin)
# }

set-tg-env() {
  local input="$1"
  local env="$2"
  local account=""

  if [[ -n "$env" ]]; then
    account="$input"
  else
    env="$input"
  fi

  if [[ -z "$env" ]]; then
    echo "Usage: set-tg-env [account] <env>"
    return 1
  fi

  if [[ -z "$account" ]]; then
    local git_url
    git_url=$(git remote get-url origin 2>/dev/null)
    if [[ $? -ne 0 || -z "$git_url" ]]; then
      echo "Error: Failed to get git remote URL or no git repo found."
      return 1
    fi

    echo "Detected Git remote: $git_url"

    if [[ "$ZSH_VERSION" ]]; then
      setopt rematchpcre 2>/dev/null
      if [[ "$git_url" =~ 'infrastructure/([^/.]+)(\.git)?$' ]]; then
        account="${match[1]}"
      else
        echo "Error: Could not extract account name (Zsh)."
        return 1
      fi
    else
      if [[ "$git_url" =~ infrastructure/([^/.]+)(\.git)?$ ]]; then
        account="${BASH_REMATCH[1]}"
      else
        echo "Error: Could not extract account name (Bash)."
        return 1
      fi
    fi
  fi

  echo "Using aws account: $account-$env"
  echo "Using environment: $env"

  export TF_VAR_environment="$env"
  export AWS_PROFILE="$account-$env"
}
