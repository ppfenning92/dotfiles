export __PROFILE="private"
export OP_ACCOUNT=my.1password.com
export AOC_TOKEN="op://dev/Advent of Code/Saved on adventofcode.com/token"
export GITLAB_TOKEN="op://Private/gitlab.com/tokens/master-key"

if type -p glab 1>/dev/null; then
  alias glab="op plugin run -- glab"
fi
if type -p tofu 1>/dev/null; then
  complete -C /opt/homebrew/bin/tofu tofu
fi
function tg() {
  op run -- terragrunt "$@"
}
complete -C /opt/homebrew/bin/terragrunt terragrunt
